{
    "compilerOptions": {
        "module": "commonjs",
        "target": "es2022",
        "outDir": "dist",
        "lib": ["es2022"],
        "sourceMap": true,
        "rootDir": "src",
        "strict": true,
        "noImplicitAny": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "resolveJsonModule": true
    },
    "exclude": ["node_modules", ".vscode-test"]
}
